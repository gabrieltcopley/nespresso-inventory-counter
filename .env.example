DATABASE_URL=postgresql://postgres:postgres@localhost:5432/coffeecounter
JWT_SECRET=change-me
ADMIN_EMAILS=you@example.com
# Who may sign up (admins can always sign up). Comma-separated.
# ALLOWED_EMAIL_DOMAINS defaults to nespresso.com when unset; set it to empty to allow only ALLOWED_EMAILS.
ALLOWED_EMAIL_DOMAINS=nespresso.com
ALLOWED_EMAILS=
RESEND_API_KEY=
EMAIL_FROM=CoffeeCounter <onboarding@resend.dev>
APP_URL=http://localhost:5173
